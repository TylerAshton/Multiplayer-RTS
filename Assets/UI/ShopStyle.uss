.shop-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    box-sizing: border-box;

}

.ability-slot-container
{
    position: relative;
}

.ability-slot {
    width: 110px;
    height: 130px;
    position: absolute;
}

.ability-button {
    width: 100px;
    height: 100px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #222;
    border-width: 2px;
    border-color: white;
}
.icon {
    width: 110px;
    height: 130px;
    background-color: black;
    background-size: contain;
    font-color: white;
}
.label {
    font-size: 12px;
    color: white;
    -unity-text-align: middle-center;
}