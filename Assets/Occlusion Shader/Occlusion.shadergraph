{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ca1dbfc89bfb4d91801c2696a91a6315",
    "m_Title": "Consider alternative solutions if performance sucks",
    "m_Content": "This is a teeny weeny inefficient BUT:\n- it is simple as you just append a material to existing objects;\n- every object using this feature is now having to render twice. Not a big deal as this shader is not doing any fancy maths.\n- Do some profiling with hundreds or thousands of objects doing this and see what happens.\n- A better way is probably using multipass shaders, which would require you to convert this into GLSL/HLSL.\n- Another nice way that you might want to look at is this: https://docs.unity3d.com/Packages/com.unity.render-pipelines.universal@12.1/manual/containers/how-to-custom-effect-render-objects.html \n- this other way just uses URP features I think but it has less control.\n\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -169.0,
        "y": 424.0,
        "width": 549.0000610351563,
        "height": 211.83648681640626
    },
    "m_Group": {
        "m_Id": ""
    }
}

